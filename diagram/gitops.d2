# How changes reach the cluster: Git is the source of truth.
# Render: d2 gitops.d2 gitops.svg
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 40
  }
}

direction: down

classes: {
  box: {
    style: {
      border-radius: 8
    }
  }
  group: {
    style: {
      border-radius: 12
      stroke-dash: 4
      font-size: 18
    }
  }
}

you: "You: git push to main" {class: box}

repo: "GitHub repo: sam-bowman/homelab-cluster" {
  class: group
  grid-columns: 3
  argocd_dir: "argocd/\nbootstrap and parent apps" {class: box}
  apps_dir: "apps/category/\nchild Application manifests" {class: box}
  manifests: "argocd/category/app/\nvalues, certs, ingress routes" {class: box}
  charts: "charts/\ndocker-app, external-services" {class: box}
  terraform: "terraform/\nDNS and Oracle Cloud" {class: box}
  ansible: "ansible/\nnode and k3s install\n(run by hand for rebuilds)" {class: box}
}

sync: "Cluster deployment: ArgoCD" {
  class: group
  direction: right
  argocd: "ArgoCD" {class: box}
  bootstrap: "argocd-bootstrap\nwatches argocd/" {class: box}
  parents: "Parent apps\nbase, network, media,\nutility, external-services" {class: box}
  children: "Child apps\none per service" {class: box}
  workloads: "Workloads" {class: box}
  argocd -> bootstrap -> parents -> children -> workloads
}

infra: "Infrastructure: Terraform" {
  class: group
  direction: right
  runner: "GitHub Actions runner\nin the cluster\n(actions-runner-controller)" {class: box}
  targets: "terraform apply updates" {
    class: group
    grid-columns: 3
    opnsense: "OPNsense\nlocal DNS" {class: box}
    cloudflare: "Cloudflare\npublic DNS" {class: box}
    oracle: "Oracle Cloud\nVPS and network" {class: box}
  }
  runner -> targets
}

you -> repo
repo -> sync: "ArgoCD polls about every 3 min"
repo -> infra: "a push touching terraform/\ntriggers the workflow"
