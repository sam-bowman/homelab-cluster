# What runs where, and how requests reach it.
# Render: d2 applications.d2 applications.svg
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 40
  }
}

direction: down

classes: {
  box: {
    style: {
      border-radius: 8
    }
  }
  group: {
    style: {
      border-radius: 12
      stroke-dash: 4
      font-size: 18
    }
  }
}

users: "You (LAN, VPN or internet)\n*.bowmans.site resolves to Traefik" {class: box}

cluster: "k3s cluster - MetalLB layer 2" {
  class: group

  traefik: "Traefik 10.10.20.101\nTLS certificates from cert-manager (Let's Encrypt)" {class: box}

  apps: "Web apps running in the cluster" {
    class: group
    grid-columns: 4
    homepage: Homepage {class: box}
    overseerr: Overseerr {class: box}
    maintainerr: Maintainerr {class: box}
    requestrr: Requestrr {class: box}
    tautulli: Tautulli {class: box}
    unifi: "UniFi controller" {class: box}
    adguard: "AdGuard Home" {class: box}
  }

  platform: "Platform UIs" {
    class: group
    grid-columns: 4
    argocd: ArgoCD {class: box}
    longhorn: Longhorn {class: box}
    vault: Vault {class: box}
    consul: Consul {class: box}
  }

  direct: "Services that skip Traefik (own load balancer IP)" {
    class: group
    grid-columns: 3
    unifi_ip: "UniFi inform\n10.10.20.202:8080" {class: box}
    adguard_ip: "AdGuard DNS\n10.10.20.205" {class: box}
    dns_ip: "Cluster DNS\n10.10.20.201" {class: box}
  }

  storage: "Longhorn volumes\n3 replicas, backed up nightly at 01:00" {class: box}

  traefik -> apps
  traefik -> platform
  apps -> storage
}

truenas: "TrueNAS apps at truenas.bowmans.site\n(proxied through ExternalName services)" {
  class: group
  grid-columns: 3
  plex: "Plex :32400" {class: box}
  sonarr: "Sonarr :30027" {class: box}
  radarr: "Radarr :30025" {class: box}
  bazarr: "Bazarr :30046" {class: box}
  sabnzbd: "SABnzbd :30055" {class: box}
  tdarr: "Tdarr :30028" {class: box}
  titlecardmaker: "Title Card Maker :34242" {class: box}
  foundry: "Foundry VTT :30000" {class: box}
  nextcloud: "Nextcloud :31234" {class: box}
}

backup: "NAS backup target\nnfs://truenas/mnt/pool/longhorn-backups" {class: box}

users -> cluster.traefik
users -> cluster.direct
cluster.traefik -> truenas: proxied
cluster.storage -> backup
