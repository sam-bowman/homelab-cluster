# Physical layout: what hardware exists and how it is cabled.
# Render: d2 hardware.d2 hardware.svg
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 40
  }
}

direction: down

classes: {
  box: {
    style: {
      border-radius: 8
    }
  }
  group: {
    style: {
      border-radius: 12
      stroke-dash: 4
      font-size: 18
    }
  }
}

internet: Internet {
  shape: cloud
}

oracle: Oracle Cloud (free tier) {
  class: group
  vps: "Ubuntu VPS\nWireGuard site-to-site host" {class: box}
  vps2: "Ubuntu VPS (secondary)" {class: box}
}

isp: "ISP router\n192.168.1.254" {class: box}

firewall: "Firewall (OPNsense)\nProtectli Vault FW6D\nIntel i5-8250U, 6 ports" {class: box}

sw2: "SMAM-SW-2 (core switch)\nUniFi US-8-60W, 8 ports (4x PoE)" {class: box}

sw1: "SMAM-SW-1\nUniFi US-8-60W, 8 ports (4x PoE)" {class: box}

ap: "SMAM-AP-1\nUniFi AC Pro" {class: box}

pve1: "PVE1 - Proxmox host, 10.10.20.70\nLenovo ThinkCentre M920q, i7-8700T, 32 GB" {
  class: group
  grid-columns: 2
  pterodactyl: "VM: Pterodactyl\n10.10.20.80" {class: box}
  haos: "VM: Home Assistant OS\n10.10.20.82" {class: box}
}

desk: "Other devices on SW-2" {
  class: group
  grid-columns: 2
  pc: "Gaming PC (10.10.10.52)\ni9-14900K, RTX 5090, 64 GB" {class: box}
  shield: "NVIDIA Shield" {class: box}
  hue: "Philips Hue Hub\n4 bulbs" {class: box}
  printer: "Elegoo Saturn\nMSLA 3D printer" {class: box}
}

cluster: "k3s cluster - 4 Raspberry Pi control-plane nodes" {
  class: group
  grid-columns: 4
  n1: "k3scluster01\n10.10.20.60" {class: box}
  n2: "k3scluster02\n10.10.20.61" {class: box}
  n3: "k3scluster03\n10.10.20.62" {class: box}
  n4: "k3scluster04\n10.10.20.63" {class: box}
}

nas: "NAS (truenas, 10.10.20.50)\nTrueNAS Scale, i5-11400, 32 GB\nMain pool: 6x 3.64 TiB RAIDZ1, 14.4 TiB usable\n+ 466 GiB SSD cache\nApp pool: 466 GiB SSD" {class: box}

internet -- isp -- firewall -- sw2
internet -- oracle

sw2 -- sw1
sw2 -- ap: "PoE"
sw2 -- pve1
sw2 -- desk

sw1 -- cluster
sw1 -- nas
