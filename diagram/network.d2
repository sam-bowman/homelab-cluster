# Logical network: VLANs, VPNs and the Oracle Cloud side.
# Render: d2 network.d2 network.svg
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 40
  }
}

direction: down

classes: {
  box: {
    style: {
      border-radius: 8
    }
  }
  group: {
    style: {
      border-radius: 12
      stroke-dash: 4
      font-size: 18
    }
  }
}

internet: Internet {
  shape: cloud
}

home: Home {
  class: group

  isp: "ISP router\n192.168.1.254" {class: box}
  firewall: "Firewall (OPNsense)\nWAN 192.168.1.x\ngateway for every VLAN" {class: box}
  ra: "WireGuard remote access\n10.10.11.0/24" {class: box}
  local_dns: "Local DNS\nAdGuard Home 10.10.20.205\nOPNsense Unbound overrides" {class: box}

  vlans: "VLANs" {
    class: group
    grid-columns: 5
    v0: "VLAN 0 Management\n10.10.0.0/24\nswitches, access point" {class: box}
    v10: "VLAN 10 LAN\n10.10.10.0/24\nPCs and daily devices" {class: box}
    v20: "VLAN 20 Servers\n10.10.20.0/24\nk3s, NAS, Proxmox, VMs" {class: box}
    v30: "VLAN 30 IoT\n10.10.30.0/24\nsmart home devices" {class: box}
    v250: "VLAN 250 Isolated\n10.10.250.0/24\nuntrusted devices" {class: box}
  }

  isp -- firewall
  ra -> firewall
  firewall -- vlans
}

oracle: "Oracle Cloud VCN 10.20.0.0/16" {
  class: group

  igw: "Internet gateway" {class: box}
  subnet: "Subnet 10.20.10.0/24" {
    class: group
    grid-columns: 2
    vps: "Ubuntu VPS\nWireGuard host\n10.10.12.1" {class: box}
    vps2: "Ubuntu VPS (secondary)" {class: box}
  }
  igw -- subnet
}

cloudflare: "Cloudflare\npublic DNS records\n(managed by Terraform)" {class: box}

internet -- home.isp
internet -- oracle.igw

home.firewall <-> oracle.subnet.vps: "WireGuard site-to-site\n10.10.12.0/31" {
  style.stroke-width: 3
}

home.vlans -> home.local_dns: resolver
internet -> cloudflare: "bowmans.site"
